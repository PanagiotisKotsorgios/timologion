// e-timologio — Phase 1 schema
// See README.md for context. All tenant-owned tables carry business_id.

generator client {
  provider      = "prisma-client-js"
  // Build client for the local dev target AND for the Alpine (musl) runtime
  // that the production Dockerfile ships, so the same schema builds cleanly
  // on both a Windows dev machine and the deployed container.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum BusinessRole {
  owner
  admin
  accountant
  staff
  sales
  readonly
}

// Platform-level role. Nullable on User: only staff of the SaaS itself carry a
// value here. Separate from BusinessRole (which is per-tenant membership).
enum PlatformRole {
  super_admin
  support
  analyst
}

enum AnnouncementTone {
  info
  warning
  success
}

model PlatformAnnouncement {
  id           String           @id @default(cuid())
  tone         AnnouncementTone @default(info)
  title        String           @db.VarChar(200)
  body         String           @db.Text
  ctaHref      String?          @db.VarChar(300)
  ctaLabel     String?          @db.VarChar(80)
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  authorId     String?
  // Optional per-tenant targeting. When null, the announcement is
  // global (visible to every logged-in tenant). When set, only that
  // business sees the banner — used for VIP notices, individual
  // scheduled maintenance, per-account escalations, etc.
  businessId   String?

  author       User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  business     Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
  @@index([businessId, publishedAt])
  @@map("platform_announcements")
}

// ─── Payments ──────────────────────────────────────────────────────────

enum PaymentMethod {
  cash
  card
  bank_transfer
  iris
  check
  credit
  other
}

model Payment {
  id           String        @id @default(cuid())
  businessId   String
  clientId     String?
  documentId   String?
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(cash)
  reference    String?       @db.VarChar(160)
  notes        String?       @db.Text
  receivedAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  document     Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([businessId, receivedAt])
  @@index([documentId])
  @@index([clientId])
  @@map("payments")
}

// ─── Recurring documents ───────────────────────────────────────────────

enum RecurrenceCadence {
  weekly
  monthly
  quarterly
  yearly
}

enum RecurrenceStatus {
  active
  paused
  ended
}

model RecurringDocument {
  id             String            @id @default(cuid())
  businessId     String
  clientId       String
  billingBookId  String?
  branchId       String?
  type           DocumentType
  label          String            @db.VarChar(160)
  cadence        RecurrenceCadence @default(monthly)
  status         RecurrenceStatus  @default(active)
  nextRunAt      DateTime
  lastRunAt      DateTime?
  paymentMethod  String?           @db.VarChar(80)
  notes          String?           @db.Text
  // Snapshot of line template: itemId, description, qty, unit, unitPrice, discountPct, vatRate
  linesJson      String            @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client         Client            @relation(fields: [clientId], references: [id])
  billingBook    BillingBook?      @relation(fields: [billingBookId], references: [id], onDelete: SetNull)
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([businessId, nextRunAt])
  @@index([status])
  @@map("recurring_documents")
}

model AppSetting {
  key         String   @id @db.VarChar(80)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

// ─── Platform billing ───────────────────────────────────────────────────
// Represents what we sell to our customers (SaaS subscriptions). Kept
// separate from the tenant-facing "Business" invoicing surface — the platform
// admin is the seller here.

enum PlanBillingCycle {
  monthly
  yearly
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

enum PlatformInvoiceStatus {
  draft
  sending
  issued
  failed
  cancelled
}

model PlatformPlan {
  id                 String   @id @default(cuid())
  code               String   @unique @db.VarChar(40)
  name               String   @db.VarChar(120)
  description        String?  @db.VarChar(400)
  priceMonthly       Decimal  @default(0) @db.Decimal(12, 2)
  priceYearly        Decimal  @default(0) @db.Decimal(12, 2)
  includedDocsMonth  Int      @default(0)
  features           String?  @db.Text
  active             Boolean  @default(true)
  sortOrder          Int      @default(100)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subscriptions      BusinessSubscription[]

  @@map("platform_plans")
}

model BusinessSubscription {
  id                  String              @id @default(cuid())
  businessId          String
  planId              String
  billingCycle        PlanBillingCycle    @default(monthly)
  status              SubscriptionStatus  @default(active)
  priceOverride       Decimal?            @db.Decimal(12, 2)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  nextBillingAt       DateTime?
  cancelledAt         DateTime?
  notes               String?             @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                PlatformPlan        @relation(fields: [planId], references: [id])
  invoices            PlatformInvoice[]

  @@index([businessId])
  @@index([status])
  @@index([nextBillingAt])
  @@map("business_subscriptions")
}

// PlatformInvoice tracks invoices the platform issues to customers via Wrapp,
// with providerCost (what Wrapp charged us) and margin (what we net).
model PlatformInvoice {
  id                 String                @id @default(cuid())
  businessId         String
  subscriptionId     String?
  periodStart        DateTime?
  periodEnd          DateTime?
  status             PlatformInvoiceStatus @default(draft)
  series             String?               @db.VarChar(20)
  number             Int?
  issueDate          DateTime              @default(now())
  description        String                @db.VarChar(255)
  netAmount          Decimal               @default(0) @db.Decimal(12, 2)
  vatAmount          Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal               @default(0) @db.Decimal(12, 2)
  providerCost       Decimal               @default(0) @db.Decimal(12, 2)
  providerRebate     Decimal               @default(0) @db.Decimal(12, 2)
  margin             Decimal               @default(0) @db.Decimal(12, 2)
  wrappInvoiceId     String?               @db.VarChar(120)
  wrappInvoiceUrl    String?               @db.VarChar(500)
  myDataMark         String?               @db.VarChar(80)
  myDataUid          String?               @db.VarChar(80)
  issuedAt           DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  business           Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription       BusinessSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([status, issueDate])
  @@map("platform_invoices")
}

// Standalone log of provider (Wrapp) costs per business — used for margin
// reporting even when a cost isn't tied to a single invoice.
model ProviderCost {
  id            String   @id @default(cuid())
  businessId    String
  periodStart   DateTime
  periodEnd     DateTime
  netAmount     Decimal  @default(0) @db.Decimal(12, 2)
  vatAmount     Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal  @default(0) @db.Decimal(12, 2)
  description   String?  @db.VarChar(255)
  invoicedAt    DateTime?
  createdAt     DateTime @default(now())

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, periodStart])
  @@map("provider_costs")
}

enum WrappStatus {
  inactive
  pending
  active
  error
}

enum ItemKind {
  service
  product
}

enum DocumentType {
  invoice
  service_invoice
  retail_receipt
  service_receipt
  simplified_invoice
  eu_sale_invoice
  third_country_sale_invoice
  eu_service_invoice
  third_country_service_invoice
  credit_note
  credit_note_correlated
  delivery_note
  stay_tax_receipt
  third_party_sale_invoice
  third_party_sale_clearing
  complementary_invoice
  complementary_service_invoice
  purchase_title
  purchase_title_refused
  self_delivery
  self_use
  contract_income
  rental_income
  retail_refund_receipt
  pos_income_receipt
  pos_payment_receipt
  retail_credit_note
  third_party_retail_receipt
  proforma
  quote
  order
}

enum DocumentStatus {
  draft
  sending
  issued
  failed
  cancelled
}

enum PaymentStatus {
  unpaid
  partial
  paid
}

// ─── Users & Auth ───────────────────────────────────────────────────────

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  emailVerifiedAt DateTime?
  passwordHash   String?       @db.VarChar(255)
  fullName       String        @db.VarChar(120)
  mfaEnabled     Boolean       @default(false)
  mfaSecretEnc   String?       @db.Text
  mfaVerifiedAt  DateTime?
  platformRole   PlatformRole?
  // Minutes of inactivity before the app auto-logs the user out. Range
  // enforced in code (5–480). Falls back to a 60-min default when the
  // user hasn't touched the setting yet.
  sessionTimeoutMinutes Int    @default(60)
  suspendedAt    DateTime?
  suspendedReason String?      @db.VarChar(255)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sessions       Session[]
  memberships    BusinessMember[]
  announcements  PlatformAnnouncement[]
  passwordResets PasswordReset[]
  emailVerifications EmailVerification[]
  mfaChallenges  MfaChallenge[]
  oauthAccounts  OAuthAccount[]
  crmTasks       CrmTask[]
  notifications  Notification[]
  appointments   Appointment[] @relation("AppointmentStaff")

  @@index([platformRole])
  @@map("users")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(128)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

/// One-time 6-digit codes emailed to the user for MFA-by-email. Replaces
/// the old Authenticator/TOTP secret model. Purposes:
///   "enroll"  – confirm the user actually controls the mailbox before
///               flipping mfaEnabled to true.
///   "login"   – challenge issued after password success on an
///               mfaEnabled account.
///   "disable" – confirm ownership before turning MFA off.
model MfaChallenge {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String    @db.VarChar(128)
  purpose    String    @db.VarChar(20)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

enum NotificationTone {
  info
  success
  warning
  danger
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  businessId String?
  tone       NotificationTone @default(info)
  title      String           @db.VarChar(200)
  body       String?          @db.Text
  href       String?          @db.VarChar(400)
  entityType String?          @db.VarChar(60)
  entityId   String?          @db.VarChar(80)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum OAuthProvider {
  google
  facebook
}

model OAuthAccount {
  id             String        @id @default(cuid())
  userId         String
  provider       OAuthProvider
  providerUserId String        @db.VarChar(191)
  email          String?       @db.VarChar(160)
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime
  usedAt     DateTime?
  ipAddress  String?   @db.VarChar(64)
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique @db.VarChar(128)
  activeBusinessId String?
  userAgent      String?   @db.VarChar(255)
  ipAddress      String?   @db.VarChar(64)
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── Businesses (tenants) ───────────────────────────────────────────────

model Business {
  id                String   @id @default(cuid())
  vatNumber         String   @db.VarChar(20)
  legalName         String   @db.VarChar(160)
  tradeName         String?  @db.VarChar(160)
  taxOffice         String?  @db.VarChar(120)
  activity          String?  @db.VarChar(200)
  addressLine       String?  @db.VarChar(200)
  city              String?  @db.VarChar(80)
  postalCode        String?  @db.VarChar(20)
  country           String   @default("GR") @db.VarChar(2)
  phone             String?  @db.VarChar(30)
  email             String?  @db.VarChar(160)
  // ΓΓΠΣ / AADE credentials for VAT (ΑΦΜ) lookup via the public reg webservice.
  // Encrypted at rest. Optional — presence unlocks real ΑΦΜ search from the app.
  aadeUsername      String?  @db.VarChar(120)
  aadePasswordEnc   String?  @db.Text
  aadeVerifiedAt    DateTime?
  // Default notes text prepended to every new document draft. Users put
  // things like bank IBAN, standard terms, footer disclaimers here so they
  // don't have to retype on each invoice. Sent to the provider verbatim.
  defaultDocumentNotes String? @db.Text
  suspendedAt       DateTime?
  suspendedReason   String?  @db.VarChar(255)
  // Admin-only annotations. Never surfaced to the tenant — visible only
  // from /admin/businesses/[id]. Support uses these for VIP flagging,
  // running notes, escalation history, refund pending, etc.
  supportNotes      String?  @db.Text
  supportTags       String?  @db.VarChar(500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members           BusinessMember[]
  wrappConnection   WrappConnection?
  clients           Client[]
  items             Item[]
  documents         Document[]
  auditLogs         AuditLog[]
  branches          Branch[]
  billingBooks      BillingBook[]
  subscriptions     BusinessSubscription[]
  platformInvoices  PlatformInvoice[]
  providerCosts     ProviderCost[]
  payments          Payment[]
  recurringDocs     RecurringDocument[]
  tags              Tag[]
  posTables         PosTable[]
  posTabs           PosTab[]
  leads             Lead[]
  opportunities     Opportunity[]
  crmTasks          CrmTask[]
  suppliers         Supplier[]
  expenses          Expense[]
  expensePayments   ExpensePayment[]
  pluginActivations PluginActivation[]
  appointments      Appointment[]
  featureFlags      BusinessFeatureFlag[]
  announcements     PlatformAnnouncement[]
  rateLimitOverrides RateLimitOverride[]

  @@index([vatNumber])
  @@map("businesses")
}

model Branch {
  id           String   @id @default(cuid())
  businessId   String
  label        String   @db.VarChar(120)
  addressLine  String?  @db.VarChar(200)
  city         String?  @db.VarChar(80)
  postalCode   String?  @db.VarChar(20)
  phone        String?  @db.VarChar(30)
  isDefault    Boolean  @default(false)
  wrappBranchId String? @db.VarChar(120)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  billingBooks BillingBook[]
  documents    Document[]
  recurringDocs RecurringDocument[]

  @@index([businessId])
  @@map("branches")
}

model BillingBook {
  id             String       @id @default(cuid())
  businessId     String
  branchId       String?
  documentType   DocumentType
  series         String       @db.VarChar(20)
  label          String?      @db.VarChar(120)
  nextNumber     Int          @default(1)
  isDefault      Boolean      @default(false)
  wrappBookId    String?      @db.VarChar(120)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  documents      Document[]
  recurringDocs  RecurringDocument[]

  @@unique([businessId, documentType, series])
  @@index([businessId, documentType])
  @@map("billing_books")
}

model BusinessMember {
  id           String       @id @default(cuid())
  userId       String
  businessId   String
  role         BusinessRole @default(staff)
  createdAt    DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("business_members")
}

model WrappConnection {
  id                 String      @id @default(cuid())
  businessId         String      @unique
  status             WrappStatus @default(inactive)
  wrappUserId        String?     @db.VarChar(120)
  wrappEmail         String?     @db.VarChar(160)
  hasPlan            Boolean     @default(false)
  canIssueInvoice    Boolean     @default(false)
  encryptedApiKey    String?     @db.Text
  encryptedJwt       String?     @db.Text
  jwtExpiresAt       DateTime?
  lastVerifiedAt     DateTime?
  lastError          String?     @db.Text
  webhookEndpoint    String?     @db.VarChar(500)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  business           Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("wrapp_connections")
}

// ─── Wrapp webhook diagnostics ──────────────────────────────────────────
// Every hit on /api/wrapp/webhook lands here regardless of outcome, so the
// user can see whether Wrapp actually called us and, if yes, why activation
// didn't stick (e.g. unknown partner_user_id, roundtrip verify failed,
// signature mismatch). Old entries are pruned by the route to keep the
// table small (~200 rows max in practice).

model WrappWebhookLog {
  id                String   @id @default(cuid())
  eventType         String?  @db.VarChar(60)
  hasSignature      Boolean  @default(false)
  verificationScope String?  @db.VarChar(20)
  partnerUserId     String?  @db.VarChar(120)
  businessMatched   Boolean  @default(false)
  outcome           String   @db.VarChar(60)
  detail            String?  @db.Text
  payloadKeys       String?  @db.VarChar(500)
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([partnerUserId, createdAt])
  @@map("wrapp_webhook_logs")
}

// ─── In-app error log ───────────────────────────────────────────────────
// Every logger.error() call persists here in production, so support can
// see recent errors from the admin panel without SSHing into the box.
// Grouped in the UI by `fingerprint` (hash of message + first stack line)
// so recurring errors show once with a count instead of flooding the list.

enum ErrorLevel {
  warn
  error
}

model ErrorLog {
  id          String     @id @default(cuid())
  level       ErrorLevel @default(error)
  message     String     @db.VarChar(500)
  fingerprint String     @db.VarChar(64)
  stack       String?    @db.Text
  path        String?    @db.VarChar(500)
  userId      String?
  businessId  String?
  meta        String?    @db.Text
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@index([fingerprint, createdAt])
  @@index([businessId, createdAt])
  @@map("error_logs")
}

// ─── Backup runs ────────────────────────────────────────────────────────
// Each execution of the /api/cron/backup endpoint appends a row here so
// admins can see when the last dump succeeded, its size, and where it
// was uploaded. Rows are kept forever — they're tiny and useful for
// forensics if a restore is ever needed.

enum BackupStatus {
  running
  success
  failed
}

model BackupRun {
  id          String       @id @default(cuid())
  status      BackupStatus @default(running)
  target      String       @db.VarChar(500)
  bytes       BigInt       @default(0)
  durationMs  Int          @default(0)
  error       String?      @db.Text
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?

  @@index([startedAt])
  @@map("backup_runs")
}

// ─── Feature flags ──────────────────────────────────────────────────────
// Global on/off per feature (rollout=all/beta/none) with per-business
// overrides via BusinessFeatureFlag. Reading is single-query — one
// findMany on the joined view. Keys are opaque strings so the code
// side stays typo-guarded via a shared constant map.

enum FeatureRollout {
  none
  beta
  all
}

model FeatureFlag {
  key         String              @id @db.VarChar(80)
  description String?             @db.VarChar(500)
  rollout     FeatureRollout      @default(none)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  overrides   BusinessFeatureFlag[]

  @@map("feature_flags")
}

model BusinessFeatureFlag {
  businessId String
  flagKey    String  @db.VarChar(80)
  enabled    Boolean
  updatedAt  DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  flag       FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@id([businessId, flagKey])
  @@index([flagKey])
  @@map("business_feature_flags")
}

// ─── Cron run history ───────────────────────────────────────────────────
// Every cron endpoint appends a row here on success/failure so /admin/cron
// can render "did X actually run and when?" without SSHing the box.
// jobKey is a free-form string ("backup", "recurring", "low-stock" etc.)
// so new crons don't need a schema change to be logged.

enum CronStatus {
  running
  success
  failed
}

model CronRun {
  id          String     @id @default(cuid())
  jobKey      String     @db.VarChar(60)
  status      CronStatus @default(running)
  itemsDone   Int        @default(0)
  durationMs  Int        @default(0)
  error       String?    @db.Text
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?

  @@index([jobKey, startedAt])
  @@index([startedAt])
  @@map("cron_runs")
}

// ─── Broadcast history ──────────────────────────────────────────────────
// Records every admin-initiated broadcast email + its recipient segment,
// so we can see "who got the September announcement" without digging
// through email provider logs.

model Broadcast {
  id           String   @id @default(cuid())
  senderId     String
  segment      String   @db.VarChar(120)
  subject      String   @db.VarChar(500)
  bodyHtml     String   @db.Text
  recipients   Int      @default(0)
  sent         Int      @default(0)
  failed       Int      @default(0)
  dryRun       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("broadcasts")
}

// ─── Email templates ────────────────────────────────────────────────────
// Editable copies of transactional email content (welcome, verify,
// reset, etc.). The code side falls back to a hardcoded template when
// a key is missing, so a bad edit degrades gracefully instead of
// silently killing email.

model EmailTemplate {
  key         String   @id @db.VarChar(80)
  description String?  @db.VarChar(500)
  subject     String   @db.VarChar(500)
  bodyHtml    String   @db.Text
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("email_templates")
}

// ─── Rate-limit overrides ───────────────────────────────────────────────
// Bump or throttle a specific action for a specific business — used to
// give VIPs more headroom or to clamp down on abusive tenants without
// suspending them entirely. The rate-limit consumer reads these before
// falling back to LIMITS defaults.

model RateLimitOverride {
  id         String   @id @default(cuid())
  businessId String
  action     String   @db.VarChar(60)
  capacity   Int
  refillMs   Int
  note       String?  @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, action])
  @@map("rate_limit_overrides")
}

// ─── Account deletion snapshots ─────────────────────────────────────────
// When a user deletes their account we take a snapshot of who they were
// + what businesses they owned so the platform admin has a record even
// after the User row is gone. Snapshot payload is a JSON string with
// contact, VAT, business counts and outstanding balances at delete
// time. Kept indefinitely for legal + support reasons (a user
// occasionally asks us to restore).

model AccountDeletionLog {
  id                String   @id @default(cuid())
  userId            String   @db.VarChar(60)
  userEmail         String   @db.VarChar(160)
  userFullName      String?  @db.VarChar(160)
  reason            String?  @db.Text
  businessesDeleted Int      @default(0)
  documentsRetained Int      @default(0)
  snapshot          String   @db.LongText
  ipAddress         String?  @db.VarChar(64)
  userAgent         String?  @db.VarChar(500)
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([userEmail])
  @@map("account_deletion_logs")
}

// ─── Audit log ──────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  businessId   String?
  userId       String?
  action       String   @db.VarChar(80)
  entityType   String?  @db.VarChar(60)
  entityId     String?  @db.VarChar(60)
  meta         String?  @db.Text
  ipAddress    String?  @db.VarChar(64)
  createdAt    DateTime @default(now())

  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ─── Clients ────────────────────────────────────────────────────────────

model Client {
  id            String   @id @default(cuid())
  businessId    String
  vatNumber     String?  @db.VarChar(20)
  legalName     String   @db.VarChar(160)
  tradeName     String?  @db.VarChar(160)
  taxOffice     String?  @db.VarChar(120)
  activity      String?  @db.VarChar(200)
  addressLine   String?  @db.VarChar(200)
  city          String?  @db.VarChar(80)
  postalCode    String?  @db.VarChar(20)
  country       String   @default("GR") @db.VarChar(2)
  email         String?  @db.VarChar(160)
  phone         String?  @db.VarChar(30)
  notes         String?  @db.Text
  tags          String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contacts      ClientContact[]
  documents     Document[]
  payments      Payment[]
  recurringDocs RecurringDocument[]
  tagLinks      ClientTag[]
  appointments  Appointment[]

  @@index([businessId, legalName])
  @@index([businessId, vatNumber])
  @@map("clients")
}

model Tag {
  id         String   @id @default(cuid())
  businessId String
  label      String   @db.VarChar(60)
  color      String   @default("#334155") @db.VarChar(9)
  createdAt  DateTime @default(now())

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clients    ClientTag[]

  @@unique([businessId, label])
  @@index([businessId])
  @@map("tags")
}

model ClientTag {
  clientId String
  tagId    String

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@index([tagId])
  @@map("client_tags")
}

model ClientContact {
  id           String   @id @default(cuid())
  clientId     String
  name         String   @db.VarChar(120)
  email        String?  @db.VarChar(160)
  phone        String?  @db.VarChar(30)
  role         String?  @db.VarChar(80)

  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

// ─── Items (services & products) ────────────────────────────────────────

model Item {
  id             String   @id @default(cuid())
  businessId     String
  kind           ItemKind @default(service)
  code           String?  @db.VarChar(60)
  name           String   @db.VarChar(160)
  description    String?  @db.Text
  unit           String   @default("τμχ") @db.VarChar(20)
  defaultPrice   Decimal  @default(0) @db.Decimal(12, 2)
  vatRate        Decimal  @default(24) @db.Decimal(5, 2)
  vatCategory    String?  @db.VarChar(20)
  active         Boolean  @default(true)
  // Inventory: null means not tracked; number is current on-hand quantity.
  stockOnHand    Decimal? @db.Decimal(14, 3)
  stockAlertAt   Decimal? @db.Decimal(14, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  documentLines  DocumentLine[]
  stockMovements StockMovement[]
  prices         ItemPrice[]
  appointments   Appointment[]

  @@index([businessId, kind])
  @@index([businessId, name])
  @@map("items")
}

enum StockMovementKind {
  in
  out
  adjustment
}

model StockMovement {
  id         String            @id @default(cuid())
  businessId String
  itemId     String
  kind       StockMovementKind
  quantity   Decimal           @db.Decimal(14, 3)
  reason     String?           @db.VarChar(200)
  documentId String?
  createdAt  DateTime          @default(now())

  item       Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([businessId, itemId])
  @@index([documentId])
  @@map("stock_movements")
}

model ItemPrice {
  id         String   @id @default(cuid())
  itemId     String
  tier       String   @db.VarChar(40)
  price      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, tier])
  @@index([itemId])
  @@map("item_prices")
}

// ─── Documents (drafts only in Phase 1) ─────────────────────────────────

model Document {
  id                  String         @id @default(cuid())
  businessId          String
  clientId            String?
  branchId            String?
  billingBookId       String?
  type                DocumentType
  status              DocumentStatus @default(draft)
  paymentStatus       PaymentStatus  @default(unpaid)

  series              String?        @db.VarChar(20)
  number              Int?

  issueDate           DateTime       @default(now())
  deliveryNoteRef     String?        @db.VarChar(120)
  paymentMethod       String?        @db.VarChar(80)
  printLanguage       String         @default("el") @db.VarChar(2)
  additionalTaxes     String?        @db.Text
  notes               String?        @db.Text

  // Delivery-note (myDATA 9.3) specifics — Πληροφορίες Διακίνησης. Only
  // populated when type == delivery_note; NULL for every other type.
  dispatchAt          DateTime?
  dispatchReason      String?        @db.VarChar(200)
  dispatchPurpose     String?        @db.VarChar(200)
  destinationAddress  String?        @db.VarChar(400)
  vehicleNumber       String?        @db.VarChar(40)
  driverName          String?        @db.VarChar(160)

  netTotalAmount      Decimal        @default(0) @db.Decimal(14, 2)
  vatTotalAmount      Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount         Decimal        @default(0) @db.Decimal(14, 2)
  payableTotalAmount  Decimal        @default(0) @db.Decimal(14, 2)

  wrappInvoiceId      String?        @db.VarChar(120)
  wrappInvoiceUrl     String?        @db.VarChar(500)
  wrappInvoiceUrlEn   String?        @db.VarChar(500)
  myDataMark          String?        @db.VarChar(80)
  myDataUid           String?        @db.VarChar(80)
  myDataQrUrl         String?        @db.VarChar(500)
  lastWrappPayload    String?        @db.Text
  lastWrappError      String?        @db.Text
  issuedAt            DateTime?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  business            Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client              Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  branch              Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  billingBook         BillingBook?   @relation(fields: [billingBookId], references: [id], onDelete: SetNull)
  lines               DocumentLine[]
  payments            Payment[]
  appointments        Appointment[]  @relation("AppointmentInvoice")

  // Correlated credit-note reference — populated when type is one of
  // credit_note_correlated (5.1) or stay_tax_receipt (8.2). Either the
  // internal parent doc id (preferred) or a raw MARK for parents
  // issued outside timologion. Wrapp requires the parent's myDATA MARK
  // on correlated payloads.
  correlatedDocumentId    String?
  correlatedMarkOverride  String?    @db.VarChar(80)
  correlatedDocument      Document?  @relation("CreditNoteParent", fields: [correlatedDocumentId], references: [id], onDelete: SetNull)
  reverseCorrelated       Document[] @relation("CreditNoteParent")

  // Foreign-transaction fields — populated when type is one of the EU /
  // third-country invoice variants (1.2 / 1.3 / 2.2 / 2.3). Currency is
  // an ISO 4217 code; exchange_rate is the multiplier that converts the
  // foreign amount to EUR at issue time. Both NULL on domestic docs.
  currency          String?   @db.VarChar(3)
  exchangeRate      Decimal?  @db.Decimal(10, 4)

  // Stay-tax fields — populated only when type == stay_tax_receipt
  // (8.2). category is the hotel star rating / accommodation type
  // string myDATA expects; amount is the total stay-tax charged.
  stayTaxCategory   String?   @db.VarChar(60)
  stayTaxAmount     Decimal?  @db.Decimal(12, 2)

  @@index([businessId, status])
  @@index([businessId, issueDate])
  @@index([businessId, clientId])
  @@index([correlatedDocumentId])
  @@map("documents")
}

model DocumentLine {
  id             String   @id @default(cuid())
  documentId     String
  itemId         String?
  ordinal        Int      @default(0)
  description    String   @db.VarChar(255)
  quantity       Decimal  @default(1) @db.Decimal(12, 3)
  unit           String   @default("τμχ") @db.VarChar(20)
  unitPrice      Decimal  @default(0) @db.Decimal(12, 2)
  discountPct    Decimal  @default(0) @db.Decimal(5, 2)
  vatRate        Decimal  @default(24) @db.Decimal(5, 2)
  netAmount      Decimal  @default(0) @db.Decimal(14, 2)
  vatAmount      Decimal  @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal  @default(0) @db.Decimal(14, 2)

  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  item           Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@map("document_lines")
}

// ─── POS / Quick Sale ───────────────────────────────────────────────────

enum PosTabStatus {
  open
  closed
  cancelled
}

model PosTable {
  id         String   @id @default(cuid())
  businessId String
  label      String   @db.VarChar(60)
  seats      Int      @default(2)
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tabs       PosTab[]

  @@unique([businessId, label])
  @@index([businessId])
  @@map("pos_tables")
}

model PosTab {
  id             String       @id @default(cuid())
  businessId     String
  tableId        String?
  label          String?      @db.VarChar(80)
  status         PosTabStatus @default(open)
  openedAt       DateTime     @default(now())
  closedAt       DateTime?
  documentId     String?      @db.VarChar(30)
  paymentMethod  String?      @db.VarChar(30)
  netTotal       Decimal      @default(0) @db.Decimal(12, 2)
  vatTotal       Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)
  notes          String?      @db.Text

  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table          PosTable?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items          PosTabItem[]

  @@index([businessId, status])
  @@index([tableId])
  @@map("pos_tabs")
}

model PosTabItem {
  id          String   @id @default(cuid())
  tabId       String
  itemId      String?
  name        String   @db.VarChar(160)
  quantity    Decimal  @default(1) @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  vatRate     Decimal  @default(24) @db.Decimal(5, 2)
  createdAt   DateTime @default(now())

  tab         PosTab   @relation(fields: [tabId], references: [id], onDelete: Cascade)

  @@index([tabId])
  @@map("pos_tab_items")
}

// ─── CRM ────────────────────────────────────────────────────────────────

enum LeadStatus {
  new
  contacted
  qualified
  disqualified
  converted
}

model Lead {
  id         String     @id @default(cuid())
  businessId String
  fullName   String     @db.VarChar(160)
  email      String?    @db.VarChar(160)
  phone      String?    @db.VarChar(40)
  company    String?    @db.VarChar(160)
  source     String?    @db.VarChar(80)
  status     LeadStatus @default(new)
  notes      String?    @db.Text
  clientId   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([businessId, status])
  @@map("leads")
}

enum OpportunityStage {
  discovery
  proposal
  negotiation
  won
  lost
}

model Opportunity {
  id           String            @id @default(cuid())
  businessId   String
  leadId       String?
  clientId     String?
  title        String            @db.VarChar(200)
  stage        OpportunityStage  @default(discovery)
  amount       Decimal           @default(0) @db.Decimal(12, 2)
  probability  Int               @default(50)
  expectedCloseAt DateTime?
  notes        String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lead         Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([businessId, stage])
  @@map("opportunities")
}

enum CrmTaskStatus {
  open
  done
  cancelled
}

model CrmTask {
  id           String        @id @default(cuid())
  businessId   String
  assigneeId   String?
  title        String        @db.VarChar(200)
  description  String?       @db.Text
  status       CrmTaskStatus @default(open)
  dueAt        DateTime?
  reminderAt   DateTime?
  leadId       String?
  clientId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignee     User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([businessId, status, dueAt])
  @@map("crm_tasks")
}

// ─── Expenses (Διαχείριση Εξόδων) ──────────────────────────────────────
// Mirror of the Client + Payment surface but for money going *out* of the
// business. Category is a plain string so users aren't forced into a fixed
// taxonomy — the UI ships a suggested list they can override per row.

enum ExpensePaymentStatus {
  unpaid
  partial
  paid
}

enum ExpenseStatus {
  draft
  recorded
  cancelled
}

model Supplier {
  id            String   @id @default(cuid())
  businessId    String
  vatNumber     String?  @db.VarChar(20)
  legalName     String   @db.VarChar(160)
  tradeName     String?  @db.VarChar(160)
  taxOffice     String?  @db.VarChar(120)
  activity      String?  @db.VarChar(200)
  addressLine   String?  @db.VarChar(200)
  city          String?  @db.VarChar(80)
  postalCode    String?  @db.VarChar(20)
  country       String   @default("GR") @db.VarChar(2)
  email         String?  @db.VarChar(160)
  phone         String?  @db.VarChar(30)
  iban          String?  @db.VarChar(40)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses      Expense[]
  payments      ExpensePayment[]

  @@index([businessId, legalName])
  @@index([businessId, vatNumber])
  @@map("suppliers")
}

model Expense {
  id              String               @id @default(cuid())
  businessId      String
  supplierId      String?
  category        String?              @db.VarChar(80)
  // myDATA expense-side type code chosen by the accountant (13.1, 13.2,
  // 13.30, 13.31, 14.1-14.5, 15.1, 16.1, 17.1-17.6). Stored as the
  // string enum-value from EXPENSE_MYDATA_TYPES in lib/expense-mydata-
  // types.ts. Nullable — legacy rows and pre-classification drafts stay
  // empty.
  myDataType      String?              @db.VarChar(40)
  reference       String?              @db.VarChar(80)
  description     String?              @db.Text
  netAmount       Decimal              @default(0) @db.Decimal(12, 2)
  vatRate         Decimal              @default(24) @db.Decimal(4, 2)
  vatAmount       Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal              @default(0) @db.Decimal(12, 2)
  currency        String               @default("EUR") @db.VarChar(3)
  paidAmount      Decimal              @default(0) @db.Decimal(12, 2)
  issueDate       DateTime
  paymentStatus   ExpensePaymentStatus @default(unpaid)
  status          ExpenseStatus        @default(recorded)
  notes           String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier        Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  payments        ExpensePayment[]

  @@index([businessId, issueDate])
  @@index([businessId, paymentStatus])
  @@index([businessId, myDataType])
  @@index([supplierId])
  @@map("expenses")
}

model ExpensePayment {
  id           String        @id @default(cuid())
  businessId   String
  expenseId    String?
  supplierId   String?
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(bank_transfer)
  reference    String?       @db.VarChar(160)
  notes        String?       @db.Text
  paidAt       DateTime      @default(now())
  createdAt    DateTime      @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expense      Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([businessId, paidAt])
  @@index([expenseId])
  @@index([supplierId])
  @@map("expense_payments")
}

// ─── Plugin add-ons (POS / CRM / Reports / Appointments) ───────────────
// Each plugin can be activated per business with a free trial. After the
// trial window closes the app blocks the plugin's routes and shows the
// tenant a "keep it running" paywall. Pricing snapshot is captured at
// activation time so a later platform-admin price change doesn't retro-
// bill a customer who signed up under the old rate.

enum PluginStatus {
  trialing
  active
  expired
  cancelled
}

model PluginActivation {
  id             String       @id @default(cuid())
  businessId     String
  pluginCode     String       @db.VarChar(40)
  status         PluginStatus @default(trialing)
  trialStartedAt DateTime     @default(now())
  trialEndsAt    DateTime
  paidUntilAt    DateTime?
  priceMonthly   Decimal      @db.Decimal(8, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, pluginCode])
  @@index([businessId, status])
  @@map("plugin_activations")
}

// ─── Feedback reports (bug reports + feature requests) ─────────────────
// Submissions from /contact#feedback — the "Αναφορά προβλήματος / Πρόταση"
// form. Persisted so we can triage without relying on inbox parsing, and
// so power users can be told "you already reported this" if they submit a
// duplicate. Kept intentionally lightweight (no thread, no comments) —
// full ticketing lives outside of this app.

enum FeedbackType {
  bug
  feature
  other
}

enum FeedbackSeverity {
  low
  medium
  high
  blocker
}

enum FeedbackStatus {
  new
  triaged
  in_progress
  resolved
  dismissed
}

model FeedbackReport {
  id            String            @id @default(cuid())
  type          FeedbackType
  severity      FeedbackSeverity  @default(medium)
  status        FeedbackStatus    @default(new)
  category      String            @db.VarChar(60)
  title         String            @db.VarChar(200)
  description   String            @db.Text
  reproSteps    String?           @db.Text
  submitterName String            @db.VarChar(120)
  submitterEmail String           @db.VarChar(160)
  businessName  String?           @db.VarChar(160)
  // Denormalised — some submitters are already logged-in users, but the
  // form is also open to anonymous visitors on /contact, so we snapshot
  // rather than require an FK.
  userId        String?
  businessId    String?
  userAgent     String?           @db.VarChar(400)
  pageUrl       String?           @db.VarChar(500)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([type, severity])
  @@map("feedback_reports")
}

// ─── Appointments (Ραντεβού & ημερολόγιο) ───────────────────────────────
// Bookings for services in the item catalogue. Optional staffUserId ties
// the slot to a specific team member; NULL = "any" or reception-managed.
// One-click convert-to-invoice writes convertedDocumentId so we don't
// re-issue the same appointment twice.

enum AppointmentStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum AppointmentLocationType {
  in_person
  online
  phone
}

model Appointment {
  id                   String                  @id @default(cuid())
  businessId           String
  staffUserId          String?
  clientId             String?
  itemId               String?
  // Free-form service name — used when no itemId is picked or as a
  // display fallback so the row still reads clearly if the linked
  // item is later deleted.
  serviceName          String                  @db.VarChar(200)
  startAt              DateTime
  endAt                DateTime
  status               AppointmentStatus       @default(scheduled)
  // Where does the meeting happen? online = detail is the URL,
  // phone = detail is the number, in_person = detail is the address.
  locationType         AppointmentLocationType @default(in_person)
  locationDetail       String?                 @db.VarChar(400)
  // Price snapshot at booking time. Falls back to the item's defaultPrice
  // when null, so the calendar can show a total even for legacy rows.
  priceOverride        Decimal?                @db.Decimal(12, 2)
  vatRate              Decimal?                @db.Decimal(4, 2)
  notes                String?                 @db.Text
  // Minutes before start to fire the reminder email. NULL = no reminder.
  // Common presets: 60 (1h), 180 (3h), 1440 (1d), 2880 (2d).
  reminderMinutesBefore Int?
  reminderSentAt       DateTime?
  // If this appointment was created by duplicating another, this is the
  // original's id. Helps the UI show "1 of 4 in series" style hints
  // when we render recurring duplicates.
  parentAppointmentId  String?
  convertedDocumentId  String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  business             Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff                User?                   @relation("AppointmentStaff", fields: [staffUserId], references: [id], onDelete: SetNull)
  client               Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  item                 Item?                   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  convertedDocument    Document?               @relation("AppointmentInvoice", fields: [convertedDocumentId], references: [id], onDelete: SetNull)

  @@index([businessId, startAt])
  @@index([businessId, status])
  @@index([staffUserId, startAt])
  @@index([clientId])
  @@index([parentAppointmentId])
  @@map("appointments")
}
